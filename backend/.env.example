# Database URL (Supabase Async PostgreSQL URI)
DATABASE_URL=postgresql+asyncpg://postgres.your-project-id:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Security
SECRET_KEY=change_this_to_a_random_256bit_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase Auth Integration (for Admin 2FA)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Go Core Data Microservice
GO_SERVICE_URL=http://localhost:8081
INTERNAL_API_SECRET=your_strong_internal_api_secret_key
